# Pad <-> core-ring power connection, computed by pdngen itself on a scratch copy of the placed chip.
#
# pdngen cannot add straps to an existing PDN (an extra ring + -connect_to_pads over the existing one
# gives PDN-0232 "grid does not contain any shapes"; its straps are trimmed as floating).  So, on a
# SCRATCH copy of the pad-placed chip ODB (chip_integrate.tcl STOP_AFTER=place):
#   1. record every VDD/VSS special shape that is NOT entirely inside the core area ("old": core ring,
#      stripe ends crossing the core boundary, ring vias);
#   2. delete all signal routing and all VDD/VSS special wiring, re-run the core's own PDN script
#      (PDN_TCL -- the DGSE cmos5l pdn scripts add -connect_to_pads to the core ring when pad cells
#      exist) -> pdngen builds the same grid plus the pad straps, and re-trims the stripe ends / ring
#      vias next to the straps so that everything is spacing-clean;
#   3. diff the shapes not entirely inside the core: DEL = old shapes pdngen did not produce again,
#      ADD = new shapes (straps, their vias, re-trimmed stripe ends);
#   4. write STRAPS_TCL, which applies DEL and ADD to the real (routed) block; chip_integrate.tcl
#      sources it.  The part of the grid inside the core is the same script on the same rows and
#      macros, i.e. identical, and is not touched.
# Measured on the mini test (work/c5l-mini2k): first version that only ADDed straps left 9 TM1.b
# spacing/notch errors against un-trimmed stripe ends; the DEL+ADD sync is the fix.
#
# env: IN_ODB, PDN_TCL, STRAPS_TCL, STRAPS_DEF (scratch result, for viewing)

set block_odb $::env(IN_ODB)
read_db $block_odb
set block [ord::get_db_block]
set core  [$block getCoreArea]
set cx0 [$core xMin]; set cy0 [$core yMin]; set cx1 [$core xMax]; set cy1 [$core yMax]
proc inside_core {b} {
    global cx0 cy0 cx1 cy1
    expr {[$b xMin] >= $cx0 && [$b yMin] >= $cy0 && [$b xMax] <= $cx1 && [$b yMax] <= $cy1}
}
proc key {b} {
    if {[$b isVia]} {
        set v [$b getBlockVia]
        set vn [expr {$v ne "NULL" ? [$v getName] : [[$b getTechVia] getName]}]
        return "V $vn [$b xMin] [$b yMin] [$b xMax] [$b yMax]"
    }
    return "W [[$b getTechLayer] getName] [$b xMin] [$b yMin] [$b xMax] [$b yMax]"
}
set old [dict create]
foreach nn {VDD VSS} {
    foreach sw [[$block findNet $nn] getSWires] {
        foreach b [$sw getWires] { if {![inside_core $b]} { dict set old "$nn [key $b]" 1 } }
    }
}
puts "PAD_PDN old shapes not inside the core: [dict size $old]"
# 2. strip routing and PDN, regenerate
foreach n [$block getNets] {
    set w [$n getWire]; if {$w ne "NULL"} { odb::dbWire_destroy $w }
    if {[$n getName] in {VDD VSS}} { foreach sw [$n getSWires] { odb::dbSWire_destroy $sw } }
}
source $::env(PDN_TCL)
pdngen
# 3. diff
set new [dict create]
set add {}
foreach nn {VDD VSS} {
    foreach sw [[$block findNet $nn] getSWires] {
        foreach b [$sw getWires] {
            if {[inside_core $b]} { continue }
            set k "$nn [key $b]"
            dict set new $k 1
            if {![dict exists $old $k]} { lappend add [list $nn $b] }
        }
    }
}
set del {}
dict for {k v} $old { if {![dict exists $new $k]} { lappend del $k } }
# A deleted stripe that crossed the core boundary may come back from pdngen split into several boxes,
# some of them entirely inside the core (first sync attempt left 1.26 um TM1 slivers = the via
# enclosures of the lost piece, TM1.a x 40).  Re-add every new inside-core wire that lies on the
# track (same layer + same cross-section) of a deleted wire.
set track [dict create]
foreach k $del {
    lassign $k nn typ ln x0 y0 x1 y1
    if {$typ ne "W"} { continue }
    if {$x1 - $x0 >= $y1 - $y0} { dict set track "$nn $ln H $y0 $y1" 1 } else { dict set track "$nn $ln V $x0 $x1" 1 }
}
set nre 0
if {[dict size $track]} {
    foreach nn {VDD VSS} {
        foreach sw [[$block findNet $nn] getSWires] {
            foreach b [$sw getWires] {
                if {[$b isVia] || ![inside_core $b]} { continue }
                set ln [[$b getTechLayer] getName]
                if {[dict exists $track "$nn $ln H [$b yMin] [$b yMax]"] || [dict exists $track "$nn $ln V [$b xMin] [$b xMax]"]} {
                    lappend add [list $nn $b]; incr nre
                }
            }
        }
    }
}
puts "PAD_PDN re-added $nre inside-core pieces of re-split stripes"
puts "PAD_PDN ADD [llength $add] shapes, DEL [llength $del] shapes"
if {[llength $add] == 0} { puts "PAD_PDN_FAIL no new shapes (pads present? PDN_TCL uses -connect_to_pads?)"; exit 1 }

# 4. STRAPS_TCL
set f [open $::env(STRAPS_TCL) w]
puts $f "# Generated by pad_pdn_straps.tcl from [file tail $block_odb]: pad <-> core-ring power sync (DEL then ADD)"
puts $f {set _b [ord::get_db_block]; set _t [[ord::get_db] getTech]
set _core [$_b getCoreArea]
proc _key {b} {
    if {[$b isVia]} {
        set v [$b getBlockVia]
        set vn [expr {$v ne "NULL" ? [$v getName] : [[$b getTechVia] getName]}]
        return "V $vn [$b xMin] [$b yMin] [$b xMax] [$b yMax]"
    }
    return "W [[$b getTechLayer] getName] [$b xMin] [$b yMin] [$b xMax] [$b yMax]"
}
# index the real block's VDD/VSS shapes that are not inside the core
set _idx [dict create]
foreach nn {VDD VSS} {
    foreach sw [[$_b findNet $nn] getSWires] {
        foreach b [$sw getWires] {
            if {[$b xMin] >= [$_core xMin] && [$b yMin] >= [$_core yMin] && [$b xMax] <= [$_core xMax] && [$b yMax] <= [$_core yMax]} { continue }
            dict set _idx "$nn [_key $b]" $b
        }
    }
}
set _ndel 0; set _nmiss 0
proc _del {k} {
    global _idx _ndel _nmiss
    if {[dict exists $_idx $k]} { odb::dbSBox_destroy [dict get $_idx $k]; dict unset _idx $k; incr _ndel } else { incr _nmiss }
}
proc _via {name cut bot top xcs ycs xsp ysp xbe ybe xte yte rows cols xo yo xto yto xbo ybo} {
    set b [ord::get_db_block]; set t [[ord::get_db] getTech]
    set v [$b findVia $name]; if {$v ne "NULL"} { return $v }
    set v [odb::dbVia_create $b $name]
    set p [odb::dbViaParams]
    $p setCutLayer [$t findLayer $cut]; $p setBottomLayer [$t findLayer $bot]; $p setTopLayer [$t findLayer $top]
    $p setXCutSize $xcs; $p setYCutSize $ycs; $p setXCutSpacing $xsp; $p setYCutSpacing $ysp
    $p setXBottomEnclosure $xbe; $p setYBottomEnclosure $ybe; $p setXTopEnclosure $xte; $p setYTopEnclosure $yte
    $p setNumCutRows $rows; $p setNumCutCols $cols; $p setXOrigin $xo; $p setYOrigin $yo
    $p setXTopOffset $xto; $p setYTopOffset $yto; $p setXBottomOffset $xbo; $p setYBottomOffset $ybo
    $v setViaParams $p
    return $v
}}
foreach k $del { puts $f "_del {$k}" }
puts $f {puts "PAD_PDN_APPLY deleted $_ndel shapes ($_nmiss not found)"}
foreach nn {VDD VSS} {
    set lines {}
    foreach a $add {
        lassign $a an b
        if {$an ne $nn} { continue }
        if {![$b isVia]} {
            lappend lines "odb::dbSBox_create \$_sw \[\$_t findLayer [[$b getTechLayer] getName]\] [$b xMin] [$b yMin] [$b xMax] [$b yMax] STRIPE"
            continue
        }
        set v [$b getBlockVia]
        if {$v ne "NULL"} {
            set p [$v getViaParams]
            set vb [$v getBBox]
            set ox [expr {[$b xMin] - [$vb xMin]}]; set oy [expr {[$b yMin] - [$vb yMin]}]
            lappend lines "odb::dbSBox_create \$_sw \[_via [$v getName] [[$p getCutLayer] getName] [[$p getBottomLayer] getName] [[$p getTopLayer] getName] [$p getXCutSize] [$p getYCutSize] [$p getXCutSpacing] [$p getYCutSpacing] [$p getXBottomEnclosure] [$p getYBottomEnclosure] [$p getXTopEnclosure] [$p getYTopEnclosure] [$p getNumCutRows] [$p getNumCutCols] [$p getXOrigin] [$p getYOrigin] [$p getXTopOffset] [$p getYTopOffset] [$p getXBottomOffset] [$p getYBottomOffset]\] $ox $oy STRIPE"
        } else {
            set v [$b getTechVia]
            set vb [$v getBBox]
            set ox [expr {[$b xMin] - [$vb xMin]}]; set oy [expr {[$b yMin] - [$vb yMin]}]
            lappend lines "odb::dbSBox_create \$_sw \[\$_t findVia [$v getName]\] $ox $oy STRIPE"
        }
    }
    if {[llength $lines]} {
        puts $f "set _sw \[odb::dbSWire_create \[\$_b findNet $nn\] ROUTED\]"
        puts $f [join $lines "\n"]
    }
}
puts $f "puts \"PAD_PDN_APPLY added [llength $add] shapes\""
close $f
foreach nn {IOVDD IOVSS} { set n [$block findNet $nn]; if {$n ne "NULL"} { foreach sw [$n getSWires] { odb::dbSWire_destroy $sw } } }
write_def $::env(STRAPS_DEF)
puts "PAD_PDN_DONE -> $::env(STRAPS_TCL)"
