# Side-move ECO on a routed (detailed-route snapshot) db: the cells listed in MOVES_FILE ("MOVE <inst> <x> <y>" um,
# pins_side.py) are moved across the macro row they were crossing, the design is re-legalized, the guides of every
# net touching a moved/displaced cell are regenerated by an incremental global route (start/end_incremental, the
# other nets' guides stay), their wires are deleted and a plain detailed_route re-routes only them (END passes).
# env: IN_ODB OUT_ODB MOVES_FILE [MAXDISP="300 300"] [END=4] [THREADS=8] [SNAP_DIR] [DRC_RPT] [GUIDE_OUT]
read_db $::env(IN_ODB)
set_thread_count [expr {[info exists ::env(THREADS)] ? $::env(THREADS) : 8}]
set block [ord::get_db_block]
set dbu [$block getDbUnitsPerMicron]
# same GRT settings as chip_grt.tcl
set_global_routing_layer_adjustment Metal2-TopMetal1 0.05
set_routing_layers -signal Metal2-TopMetal1
global_route -start_incremental
set moved {}
set miss 0
set fh [open $::env(MOVES_FILE) r]
while {[gets $fh line] >= 0} {
    set p [split [string trim $line]]
    if {[lindex $p 0] ne "MOVE"} { continue }
    set inst [$block findInst [lindex $p 1]]
    if {$inst eq "NULL"} { incr miss; continue }
    set bb [$inst getBBox]
    set w [expr {[$bb xMax] - [$bb xMin]}]; set h [expr {[$bb yMax] - [$bb yMin]}]
    set cx [expr {round([lindex $p 2] * $dbu)}]; set cy [expr {round([lindex $p 3] * $dbu)}]
    $inst setLocation [expr {$cx - $w / 2}] [expr {$cy - $h / 2}]
    $inst setPlacementStatus PLACED
    lappend moved $inst
}
close $fh
puts "ECO_SIDE moved [llength $moved] cells ($miss names not found)"
set before [dict create]
foreach inst [$block getInsts] {
    if {[[$inst getMaster] isCore]} { dict set before [$inst getName] [$inst getLocation] }
}
set md [expr {[info exists ::env(MAXDISP)] ? $::env(MAXDISP) : "300 300"}]
set removed {}
foreach bt [$block getBTerms] {
    if {[llength [$bt getBPins]] == 0} {
        lappend removed [list [$bt getName] [[$bt getNet] getName] [$bt getIoType] [$bt getSigType]]
        odb::dbBTerm_destroy $bt
    }
}
set_placement_padding -global -left 1 -right 1
detailed_placement -max_displacement $md
check_placement -verbose
foreach r $removed {
    lassign $r bn nn io st
    set bt [odb::dbBTerm_create [$block findNet $nn] $bn]
    $bt setIoType $io
    $bt setSigType $st
}
set touched [dict create]
set nshift 0
foreach inst [$block getInsts] {
    if {![[$inst getMaster] isCore]} { continue }
    if {[dict get $before [$inst getName]] eq [$inst getLocation]} { continue }
    incr nshift
    foreach it [$inst getITerms] {
        set net [$it getNet]
        if {$net ne "NULL" && [$net getSigType] eq "SIGNAL"} { dict set touched [$net getName] $net }
    }
}
puts "ECO_SIDE cells displaced (moved + legalizer): $nshift, nets touched: [dict size $touched]"
# wires off first, so the incremental GRT and the DRT start clean on these nets
set nd 0
dict for {name net} $touched {
    set w [$net getWire]
    if {$w ne "NULL"} { odb::dbWire_destroy $w; incr nd }
}
puts "ECO_SIDE routing deleted on $nd nets"
global_route -end_incremental -allow_congestion
puts "ECO_SIDE incremental global route done"
if {[info exists ::env(GUIDE_OUT)] && $::env(GUIDE_OUT) ne ""} { write_guides $::env(GUIDE_OUT) }
set rpt [expr {[info exists ::env(DRC_RPT)] ? $::env(DRC_RPT) : "[file rootname $::env(OUT_ODB)]_drc.rpt"}]
set end [expr {[info exists ::env(END)] ? $::env(END) : 4}]
if {[info exists ::env(SNAP_DIR)] && $::env(SNAP_DIR) ne ""} {
    file mkdir $::env(SNAP_DIR)
    detailed_route_debug -snapshot_dir $::env(SNAP_DIR)
    set_debug_level DRT snapshot 1
}
detailed_route -output_drc $rpt -droute_end_iter $end -verbose 1
set unrouted 0
foreach net [$block getNets] {
    if {[$net getSigType] ne "SIGNAL"} { continue }
    if {[$net getWire] eq "NULL" && [llength [$net getITerms]] > 1} { incr unrouted }
}
puts "ECO_SIDE unrouted multi-pin signal nets after: $unrouted"
write_db $::env(OUT_ODB)
puts "ECO_SIDE done $::env(OUT_ODB)"
